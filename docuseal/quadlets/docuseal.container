[Unit]
Description=DocuSeal document signing
StartLimitIntervalSec=60
StartLimitBurst=3
After=network-online.target

[Container]
Image=docker.io/docuseal/docuseal:2.4.4
ContainerName=docuseal
Network=docuseal.network
PublishPort=${SERVICE_PORT_HTTP}:3000
# DocuSeal stores SQLite db, uploaded PDFs, signed outputs, and a secret
# encryption key under /data. Bind mount so the data survives container
# replacement and is inspectable from the host.
Volume=${SERVICE_HOME}/data:/data:Z,U
EnvironmentFile=%h/.local/share/services/docuseal/.env
# Probe 127.0.0.1, not localhost: the container's /etc/hosts maps localhost to
# both 127.0.0.1 and ::1, wget tries ::1 first, and docuseal binds IPv4-only
# (0.0.0.0:3000). localhost would get connection-refused forever, so the
# container could never go healthy.
HealthCmd=wget -qO- http://127.0.0.1:3000/up >/dev/null || exit 1
HealthStartPeriod=30s
HealthInterval=15s
HealthRetries=5
HealthTimeout=5s
Pull=missing

[Service]
EnvironmentFile=%h/.local/share/services/docuseal/.env
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
