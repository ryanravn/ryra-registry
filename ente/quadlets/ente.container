[Unit]
Description=Ente Museum API server
StartLimitIntervalSec=60
StartLimitBurst=3
Requires=ente-postgres.service ente-minio.service
After=ente-postgres.service ente-minio.service
Wants=ente-web.service

[Container]
Image=ghcr.io/ente-io/server@sha256:6a1a76df708c29affb833cf2a89f1b4b318f58f15e64cb0249e76cd8cd1df304
ContainerName=ente-museum
Network=ente.network:alias=museum
PublishPort=${SERVICE_PORT_HTTP}:8080
Pull=missing
EnvironmentFile=%h/.local/share/services/ente/.env
# The museum (server) image is busybox-based and ships wget, not curl —
# a curl healthcheck fails with "curl: not found" and the container is
# stuck `unhealthy` forever despite serving fine. (ente-web's image does
# have curl, so it keeps the curl check below.)
HealthCmd=wget -q -O /dev/null http://localhost:8080/ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
EnvironmentFile=%h/.local/share/services/ente/.env
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
