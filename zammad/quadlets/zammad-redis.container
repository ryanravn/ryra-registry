[Unit]
Description=Zammad Redis
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=docker.io/library/redis:8.6.2-alpine
ContainerName=zammad-redis
Network=zammad.network:alias=redis
Volume=${SERVICE_HOME}/redis-data:/data:Z,U
HealthCmd=redis-cli ping | grep -q PONG
HealthStartPeriod=5s
HealthInterval=10s
HealthRetries=5
HealthTimeout=3s
Pull=missing

[Service]
# Service-level env only: ${SERVICE_HOME} in Volume= expands in the
# generated ExecStart from here. The container env stays clean.
EnvironmentFile=%h/.local/share/services/zammad/.env
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
