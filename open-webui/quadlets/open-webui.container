[Unit]
Description=Open WebUI - AI chat interface
StartLimitIntervalSec=60
StartLimitBurst=3
After=network-online.target

[Container]
ContainerName=open-webui
Image=ghcr.io/open-webui/open-webui:0.8.12
Network=open-webui.network
PublishPort=${SERVICE_PORT_HTTP}:8080
Volume=${SERVICE_HOME}/data:/app/backend/data:Z,U
EnvironmentFile=%h/.local/share/services/open-webui/.env
Pull=missing
HealthCmd=curl -sf http://localhost:8080/ || exit 1

[Service]
EnvironmentFile=%h/.local/share/services/open-webui/.env
# CA trust for --auth installs; best-effort, sandbox-safe (SERVICE_HOME
# passed through), reads certifi's real path from the running container.
ExecStartPost=-/bin/bash ${SERVICE_HOME}/configs/scripts/merge-ca-bundle.sh ${SERVICE_HOME}
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
